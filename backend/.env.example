# Variables de entorno - EJEMPLO
NODE_ENV=development
PORT=5002

# MongoDB Atlas connection - CAMBIAR POR TU URL
MONGODB_URI=mongodb+srv://tu_usuario:tu_password@tu_cluster.mongodb.net/Lumineers

# Nombre de la colección de tickets en MongoDB (OBLIGATORIA).
# Es la única fuente de verdad: para cambiar de evento o renombrar la
# colección, se cambia solo aquí (o en las variables del servicio en
# producción), sin tocar código. Si falta, el backend no arranca.
COLLECTION_NAME=NombreDeTuColeccion

# JWT Secret - GENERAR UNO NUEVO Y SEGURO
JWT_SECRET=tu_jwt_secret_super_seguro_aqui

# Default admin password
DEFAULT_PASSWORD=tu_password_admin

# Logs
LOG_LEVEL=info

# CORS Origin para producción
CORS_ORIGIN=https://tu-frontend-en-render.com
